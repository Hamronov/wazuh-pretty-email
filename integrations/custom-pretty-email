def send_email(cfg, subject, text_body, html_body):
    smtp_host = cfg["smtp_host"]
    smtp_port = int(cfg.get("smtp_port", 25))
    sender = cfg["from"]
    from_name = cfg.get("from_name", "")
    timeout = int(cfg.get("smtp_timeout", 20))
    recipients = as_list(cfg.get("to"))

    if not recipients:
        raise RuntimeError("No recipients configured")

    msg = MIMEMultipart("alternative")
    msg["Subject"] = str(Header(subject, "utf-8"))
    msg["From"] = f"{from_name} <{sender}>" if from_name else sender
    msg["To"] = ", ".join(recipients)

    msg.attach(MIMEText(text_body, "plain", "utf-8"))
    msg.attach(MIMEText(html_body, "html", "utf-8"))

    with smtplib.SMTP(smtp_host, smtp_port, timeout=timeout) as server:
        server.ehlo()
        server.sendmail(sender, recipients, msg.as_string())


HEALTH_STATE_PATH = '/var/ossec/var/run/custom_pretty_email_health.json'
HEALTH_TTLS = {'204': 6 * 3600, '241': 24 * 3600}


def process_health(cfg, alert=None, state_path=HEALTH_STATE_PATH):
    """First alert immediately; timed summaries of repeats, separately per agent/rule.

    Separate lock inode allows atomic state replacement. SMTP failures preserve
    pending summaries and do not mark a failed first notification as delivered.
    """
    import os
    import copy
    import tempfile
    now = time.time()
    with open(state_path + '.lock', 'a') as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            with open(state_path, encoding='utf-8') as f:
                state = json.load(f)
        except FileNotFoundError:
            state = {}
        def save():
            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(state_path), prefix='.health-')
            try:
                with os.fdopen(fd, 'w', encoding='utf-8') as f:
                    json.dump(state, f, ensure_ascii=False)
                    f.flush()
                    os.fsync(f.fileno())
                os.replace(tmp, state_path)
            finally:
                if os.path.exists(tmp):
                    os.unlink(tmp)
        def deliver(a):
            send_email(cfg, *build_messages(get_alert_meta(a), cfg))
        def flush_one(key):
            item = state[key]
            if now < item['due']:
                return
            if item['repeats']:
                summary = copy.deepcopy(item['alert'])
                summary['rule']['description'] = (
                    'Сводка повторов: ' + item['description'] +
                    ' — повторных событий: ' + str(item['repeats']) +
                    '; первое: ' + item['first'] + '; последнее: ' + item['last'] +
                    '. Первое уведомление отправлено отдельно. Восстановление не подтверждено.'
                )
                deliver(summary)
                item['repeats'] = 0
                item['due'] = now + HEALTH_TTLS[item['rule']]
            else:
                del state[key]
            save()
        if alert is None:
            errors = []
            for key in list(state):
                try:
                    flush_one(key)
                except Exception as e:
                    errors.append(str(e))
            if errors:
                raise RuntimeError('Health summaries pending retry: ' + '; '.join(errors))
            return
        rid = str(alert['rule']['id'])
        agent = alert.get('agent', {})
        identity = str(agent.get('id') or agent.get('name') or '')
        if not identity:
            deliver(alert)
            return
        key = rid + ':' + identity
        if key in state:
            # Persist the new event before trying any overdue summary.
            item = state[key]
            item['repeats'] += 1
            item['last'] = str(alert.get('timestamp', ''))
            item['alert'] = alert
            save()
            flush_one(key)
            return
        deliver(alert)
        state[key] = {'rule': rid, 'due': now + HEALTH_TTLS[rid],
                      'repeats': 0, 'first': str(alert.get('timestamp', '')),
                      'last': str(alert.get('timestamp', '')),
                      'description': alert['rule']['description'], 'alert': alert}
        save()


def main():
    if len(sys.argv) < 2:
        raise RuntimeError("Usage: custom-pretty-email <alert_json_path>")

    if sys.argv[1] == "--flush-health":
        process_health(load_json(CONFIG_PATH))
        return

    alert_path = sys.argv[1]
    cfg = load_json(CONFIG_PATH)
    alert = load_json(alert_path)

    # ── ПРОВЕРКА ИСКЛЮЧЕНИЙ ──────────────────────
    matched_exclusion = check_exclusions(alert)
    if matched_exclusion:
        sys.stderr.write(
            f"custom-pretty-email: alert suppressed by exclusion "
            f"'{matched_exclusion}'\n"
        )
        sys.exit(0)
    # ─────────────────────────────────────────────

    if str(alert.get("rule", {}).get("id", "")) in HEALTH_TTLS:
        process_health(cfg, alert)
        return

    dedup_key, is_duplicate = reserve_dedup(alert)
    if is_duplicate:
        sys.stderr.write(
            "custom-pretty-email: duplicate incident suppressed "
            f"for rule '{alert.get('rule', {}).get('id', '-')}'\n"
        )
        sys.exit(0)

    meta = get_alert_meta(alert)
    subject, text_body, html_body = build_messages(meta, cfg)
    try:
        send_email(cfg, subject, text_body, html_body)
    except Exception:
        release_dedup(dedup_key)
        raise


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        sys.stderr.write(f"custom-pretty-email failed: {e}\n")
        sys.exit(1)
