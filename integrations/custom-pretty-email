def pick(*values, default=""):
    for v in values:
        if v is None:
            continue
        if isinstance(v, str):
            if v.strip():
                return v.strip()
        elif v != "":
            return v
    return default


def as_list(v):
    if v is None:
        return []
    if isinstance(v, list):
        return [str(x).strip() for x in v if str(x).strip()]
    if isinstance(v, str):
        return [x.strip() for x in v.split(",") if x.strip()]
    return [str(v)]


def severity(level):
    try:
        level = int(level)
    except Exception:
        level = 0

    if level >= 15:
        return "CRITICAL", "#b91c1c"
    if level >= 12:
        return "HIGH", "#ea580c"
    if level >= 8:
        return "MEDIUM", "#d97706"
    if level >= 5:
        return "LOW", "#2563eb"
    return "INFO", "#475569"


def shorten(text, limit=140):
    text = str(text)
    return text if len(text) <= limit else text[:limit - 1] + "…"


def path_basename(path):
    path = str(path).replace("\\", "/").rstrip("/")
    return path.split("/")[-1] if path else ""


def build_mitre_text(mitre):
    if not isinstance(mitre, dict) or not mitre:
        return ""

    parts = []

    ids = as_list(mitre.get("id"))
    tactics = as_list(mitre.get("tactic"))
    techniques = as_list(mitre.get("technique"))

    if ids:
        parts.append("ID: " + ", ".join(ids))
    if tactics:
        parts.append("Tactic: " + ", ".join(tactics))
    if techniques:
        parts.append("Technique: " + ", ".join(techniques))

    return " | ".join(parts)


def normalize_iso_datetime(value):
    s = str(value).strip()
    if not s:
        return ""

    if s.endswith("Z"):
        s = s[:-1] + "+00:00"

    if len(s) >= 5 and (s[-5] in ["+", "-"]) and s[-2] != ":" and s[-4:].isdigit():
        s = s[:-2] + ":" + s[-2:]

    if "." in s:
        head, tail = s.split(".", 1)
        tz_pos = max(tail.rfind("+"), tail.rfind("-"))
        if tz_pos != -1:
            frac = tail[:tz_pos]
            tz = tail[tz_pos:]
        else:
            frac = tail
            tz = ""

        frac_digits = "".join(ch for ch in frac if ch.isdigit())
        if frac_digits:
            frac_digits = frac_digits[:6]
            s = f"{head}.{frac_digits}{tz}"
        else:
            s = f"{head}{tz}"

    return s


def parse_timestamp(value):
    if not value:
        return None

    raw = str(value).strip()
    norm = normalize_iso_datetime(raw)

    candidates = [norm, raw]

    for item in candidates:
        try:
            dt = datetime.fromisoformat(item)
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=timezone.utc)
            return dt.astimezone(timezone.utc)
        except Exception:
            pass

    formats = [
        "%Y-%m-%d %H:%M:%S.%f",
        "%Y-%m-%d %H:%M:%S",
        "%Y-%m-%dT%H:%M:%S.%f",
        "%Y-%m-%dT%H:%M:%S"
    ]

    for fmt in formats:
        try:
            dt = datetime.strptime(raw, fmt).replace(tzinfo=timezone.utc)
            return dt
        except Exception:
            pass

    return None


def format_utc(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")


def rison_escape(value):
    s = str(value)
    s = s.replace("!", "!!")
    s = s.replace("'", "!'")
    return s


def build_event_query(meta):
    alert_id = meta.get("alert_id", "")
    rule_id = meta.get("rule_id", "")
    host = meta.get("host", "")
    agent_id = meta.get("agent_id", "")
    event_id = meta.get("event_id", "")

    if alert_id and alert_id != "-":
        return f'id:"{alert_id}"'

    parts = []
    if rule_id and rule_id != "-":
        parts.append(f'rule.id:{rule_id}')
    if agent_id and agent_id != "-":
        parts.append(f'agent.id:"{agent_id}"')
    elif host:
        parts.append(f'agent.name:"{host}"')
    if event_id:
        parts.append(f'data.win.system.eventID:"{event_id}"')

    return " and ".join(parts)


def build_event_url(meta, cfg):
    base = str(cfg.get("dashboard_url", "") or "").strip().rstrip("/")
    if not base:
        return ""

    query_text = build_event_query(meta)
    if not query_text:
        return base

    dt = parse_timestamp(meta.get("timestamp"))
    if dt:
        time_from = format_utc(dt - timedelta(minutes=30))
        time_to = format_utc(dt + timedelta(minutes=30))
    else:
        time_from = "now-24h"
        time_to = "now"

    a_part = "(discover:(columns:!(_source),isDirty:!f,sort:!()),metadata:(indexPattern:'wazuh-alerts-*',view:discover))"
    g_part = f"(filters:!(),refreshInterval:(pause:!t,value:0),time:(from:'{time_from}',to:'{time_to}'))"
    q_part = f"(filters:!(),query:(language:kuery,query:'{rison_escape(query_text)}'))"

    safe_chars = "()!,:*'\"-_./"

    return (
        f"{base}/app/data-explorer/discover"
        f"#?_a={quote(a_part, safe=safe_chars)}"
        f"&_g={quote(g_part, safe=safe_chars)}"
        f"&_q={quote(q_part, safe=safe_chars)}"
    )


def build_title(meta):
    rule_desc = meta.get("rule_desc", "Wazuh alert")
    target_file = meta.get("target_file", "")
    process = meta.get("process", "")
    src_ip = meta.get("src_ip", "")
    dst_ip = meta.get("dst_ip", "")

    if target_file:
        return f"{rule_desc} — {path_basename(target_file)}"
    if process:
        return f"{rule_desc} — {path_basename(process)}"
    if src_ip and dst_ip:
        return f"{rule_desc} — {src_ip} → {dst_ip}"
    return rule_desc


def build_story(meta):
    parts = [
        f"На хосте {meta.get('host', 'unknown-host')} сработало правило {meta.get('rule_id', '-')} — {meta.get('rule_desc', 'Wazuh alert')}."
    ]

    if meta.get("provider"):
        parts.append(f"Источник события: {meta['provider']}.")
    if meta.get("user"):
        parts.append(f"Пользователь: {meta['user']}.")
    if meta.get("process"):
        parts.append(f"Процесс: {meta['process']}.")
    if meta.get("parent_process"):
        parts.append(f"Родительский процесс: {meta['parent_process']}.")
    if meta.get("target_file"):
        parts.append(f"Объект/файл: {meta['target_file']}.")
    if meta.get("command_line"):
        parts.append(f"Командная строка: {shorten(meta['command_line'], 300)}.")

    if meta.get("src_ip") or meta.get("dst_ip"):
        network = []
        if meta.get("src_ip"):
            src = meta["src_ip"]
            if meta.get("src_port"):
                src += f":{meta['src_port']}"
            network.append(src)
        if meta.get("dst_ip"):
            dst = meta["dst_ip"]
            if meta.get("dst_port"):
                dst += f":{meta['dst_port']}"
            if network:
                network.append("→")
            network.append(dst)
        if meta.get("protocol"):
            network.append(f"({meta['protocol']})")
        parts.append("Сетевой контекст: " + " ".join(network) + ".")

    if meta.get("action"):
        parts.append(f"Действие: {meta['action']}.")
    if meta.get("status"):
        parts.append(f"Статус: {meta['status']}.")
    if meta.get("domain"):
        parts.append(f"Домен/хост: {meta['domain']}.")
    if meta.get("url"):
        parts.append(f"URL: {meta['url']}.")
    if meta.get("hashes"):
        parts.append(f"Хэши: {shorten(meta['hashes'], 300)}.")

    return " ".join(parts)


