def get_dedup_key(alert):
    """Возвращает ключ инцидента для правил, где допустимо одно письмо."""
    rule_id = str(alert.get("rule", {}).get("id", ""))
    if rule_id not in DEDUP_TTLS:
        return None, None

    full_log = alert.get("full_log", "")
    try:
        correlation = json.loads(full_log) if isinstance(full_log, str) else full_log
    except (TypeError, ValueError):
        return None, None

    if not isinstance(correlation, dict):
        return None, None

    target = str(correlation.get("targetUserName", "")).strip().lower()
    actor = str(correlation.get("resetActor", "")).strip().lower()
    reset_timestamp = str(correlation.get("resetTimestamp", "")).strip()
    if not target or not reset_timestamp:
        return None, None

    raw_key = "|".join((rule_id, target, actor, reset_timestamp))
    key = hashlib.sha256(raw_key.encode("utf-8")).hexdigest()
    return key, DEDUP_TTLS[rule_id]


def reserve_dedup(alert, state_path=DEDUP_STATE_PATH):
    """Атомарно резервирует отправку; возвращает (key, duplicate)."""
    key, ttl = get_dedup_key(alert)
    if not key:
        return None, False

    now = time.time()
    try:
        with open(state_path, "a+", encoding="utf-8") as state_file:
            fcntl.flock(state_file.fileno(), fcntl.LOCK_EX)
            state_file.seek(0)
            try:
                state = json.load(state_file)
            except (ValueError, TypeError):
                state = {}
            if not isinstance(state, dict):
                state = {}

            state = {
                saved_key: saved_at
                for saved_key, saved_at in state.items()
                if isinstance(saved_at, (int, float)) and now - saved_at < 2 * 24 * 60 * 60
            }
            duplicate = key in state and now - state[key] < ttl
            if not duplicate:
                state[key] = now

            state_file.seek(0)
            state_file.truncate()
            json.dump(state, state_file, ensure_ascii=False)
            state_file.flush()
            fcntl.flock(state_file.fileno(), fcntl.LOCK_UN)
    except Exception as error:
        sys.stderr.write(f"custom-pretty-email: dedup unavailable, sending alert: {error}\n")
        return None, False

    return key, duplicate


def release_dedup(key, state_path=DEDUP_STATE_PATH):
    """Освобождает резерв, если SMTP-отправка завершилась ошибкой."""
    if not key:
        return

    try:
        with open(state_path, "a+", encoding="utf-8") as state_file:
            fcntl.flock(state_file.fileno(), fcntl.LOCK_EX)
            state_file.seek(0)
            try:
                state = json.load(state_file)
            except (ValueError, TypeError):
                state = {}
            if isinstance(state, dict):
                state.pop(key, None)
            else:
                state = {}
            state_file.seek(0)
            state_file.truncate()
            json.dump(state, state_file, ensure_ascii=False)
            state_file.flush()
            fcntl.flock(state_file.fileno(), fcntl.LOCK_UN)
    except Exception as error:
        sys.stderr.write(f"custom-pretty-email: failed to release dedup key: {error}\n")


