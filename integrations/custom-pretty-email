def flatten_alert_to_text(alert, _depth=0):
    """
    Рекурсивно собирает ВСЕ строковые значения из алерта
    в одну большую строку для поиска ключевых слов.
    """
    if _depth > 20:
        return ""

    parts = []

    if isinstance(alert, dict):
        for key, value in alert.items():
            parts.append(str(key))
            parts.append(flatten_alert_to_text(value, _depth + 1))
    elif isinstance(alert, list):
        for item in alert:
            parts.append(flatten_alert_to_text(item, _depth + 1))
    else:
        parts.append(str(alert))

    return " ".join(parts)


def get_nested_value(data, dotted_path):
    """Получает значение из вложенного словаря по пути вида data.win.eventdata.image."""
    value = data
    for part in str(dotted_path).split("."):
        if not isinstance(value, dict) or part not in value:
            return None
        value = value[part]
    return value


def check_exclusions(alert, exclusions_path=EXCLUSIONS_PATH):
    """
    Проверяет алерт по списку исключений.
    
    Каждое исключение содержит список keywords.
    Если ВСЕ keywords из одного исключения найдены в алерте
    (регистронезависимо) — возвращает имя сработавшего исключения.
    
    Возвращает:
      - None — исключений не сработало, отправляем
      - str  — имя сработавшего исключения, НЕ отправляем
    """
    exclusions = load_json_safe(exclusions_path, default=[])

    if not exclusions:
        return None

    # Собираем весь текст алерта в одну строку (lowercase)
    alert_text = flatten_alert_to_text(alert).lower()

    for idx, rule in enumerate(exclusions):
        if not isinstance(rule, dict):
            continue

        keywords = rule.get("keywords", [])
        if not keywords or not isinstance(keywords, list):
            continue

        rule_name = rule.get("name", f"exclusion_{idx}")

        # Проверяем: ВСЕ ключевые слова должны присутствовать
        all_found = True
        for kw in keywords:
            kw_lower = str(kw).strip().lower()
            if not kw_lower:
                continue
            if kw_lower not in alert_text:
                all_found = False
                break

        field_equals = rule.get("field_equals", {})
        if all_found and isinstance(field_equals, dict):
            for field_path, expected in field_equals.items():
                actual = get_nested_value(alert, field_path)
                if str(actual).casefold() != str(expected).casefold():
                    all_found = False
                    break

        if all_found:
            for field_path, pattern in rule.get("field_regex", {}).items():
                actual = get_nested_value(alert, field_path)
                # Sysmon JSON may contain doubled Windows separators.
                normalized = re.sub(r"\\+", lambda m: "\\", str(actual)) if actual is not None else ""
                if not re.fullmatch(pattern, normalized, re.IGNORECASE):
                    all_found = False
                    break

        if all_found:
            return rule_name

    return None


