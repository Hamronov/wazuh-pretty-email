    win = data.get("win", {}) if isinstance(data.get("win"), dict) else {}
    if not win and isinstance(alert.get("win"), dict):
        win = alert.get("win", {})

    system = win.get("system", {}) if isinstance(win.get("system"), dict) else {}
    eventdata = win.get("eventdata", {}) if isinstance(win.get("eventdata"), dict) else {}

    level = pick(rule.get("level"), default="0")
    sev_name, sev_color = severity(level)

    fqdn = pick(system.get("computer"))
    host = pick(
        agent.get("name"),
        fqdn,
        alert.get("hostname"),
        default="unknown-host"
    )

    timestamp = pick(
        alert.get("timestamp"),
        system.get("systemTime"),
        default="-"
    )

    rule_id = pick(rule.get("id"), default="-")
    rule_desc = pick(rule.get("description"), default="Wazuh alert")
